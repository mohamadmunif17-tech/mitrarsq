# Salin file ini menjadi ".env" (tanpa akhiran .example), lalu isi dengan
# Project URL dan anon key dari Supabase (Project Settings > API).
#
# Untuk deploy di Vercel, JANGAN upload file .env — sebagai gantinya,
# masukkan dua variabel ini di: Vercel Dashboard > Project > Settings >
# Environment Variables.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
